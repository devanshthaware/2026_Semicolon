      "page": "/api/v1/keys/[keyId]",
      "regex": "^/api/v1/keys/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPkeyId": "nxtPkeyId"
      },
      "namedRegex": "^/api/v1/keys/(?<nxtPkeyId>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
