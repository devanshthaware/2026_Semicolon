# Argus Platform Environment Configuration

# PostgreSQL Database URL
DATABASE_URL="postgresql://argus:argus@localhost:5432/argus?schema=public"

# NextAuth Secret Key
AUTH_SECRET="your_nextauth_secret_key_here"

# API Base URL (Defaults to relative /api/v1 for Next.js endpoints)
NEXT_PUBLIC_API_URL="/api/v1"

# LangGraph / Python Backend Services
LANGGRAPH_URL="http://localhost:8000"
