# PostgreSQL connection for Prisma. Example for local Docker/Postgres.
DATABASE_URL="postgresql://truthlayer:truthlayer@localhost:5432/truthlayer?schema=public"

# Required only while bootstrapping the first organization and API key.
TRUTHLAYER_BOOTSTRAP_TOKEN=change-this-before-use

# Required by Auth.js. Generate a 32+ byte random value for every environment.
AUTH_SECRET=replace-with-a-long-random-secret

# Optional FastAPI verification engine. Leave unset to use the local development fallback.
TRUTHLAYER_ENGINE_URL=http://localhost:8000
