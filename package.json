{
  "name": "argus",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:platform": "pnpm --filter @argus/platform dev",
    "dev:showcase": "pnpm --filter @argus/showcase dev",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "type-check": "pnpm --recursive build",
    "test": "pnpm --recursive lint",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:seed": "node seed-test.js",
    "artifacts:generate": "node scripts/generate-synthetic-artifacts.mjs"
  },
  "devDependencies": {
    "prisma": "^6.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma"
    ]
  }
}
